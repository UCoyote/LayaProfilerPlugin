{
  "manifest_version": 3,
  "name": "Game Profiler",
  "description": "LayaAir / Cocos Creator 3.8 引擎性能分析工具，提供节点树、资源、GPU内存占用、帧统计、控制台的分析。",
  "version": "0.2.2",
  "author": "UCoyote",
  "devtools_page": "devtools.html",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Game Profiler     Author:UCoyote   Email: 501202461@qq.com",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' data: blob: http: https:;"
  }
}
